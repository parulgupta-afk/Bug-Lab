# Copy this file to .env and fill it in. The server works without it; only the optional AI tutor needs a key.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional: enables POST /api/tutor (supports Google Gemini or Anthropic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or Anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

